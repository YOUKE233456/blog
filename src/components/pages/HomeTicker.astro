---
// 首页公告跑马灯（fqzlr.com 同款结构：section.home-ticker > div.home-ticker__inner）
// 位于内容区最顶部（分类导航之前）
// 每条公告依次显示：滑入 → 停留 → 下一条（JS 轮换，可靠）
// 上下边框跟随主题色相
// 数据与开关见 src/config/homeWidgetsConfig.ts 的 marquee
import { homeWidgetsConfig } from "@/config/homeWidgetsConfig";

const { marquee } = homeWidgetsConfig;

const itemClass = "home-ticker__item";
const tagClass = "home-ticker__tag";
const textClass = "home-ticker__text";
---

{
	marquee.enable && marquee.items.length > 0 && (
		<section id="home-ticker" class="home-ticker" aria-label="公告跑马灯">
			<div class="home-ticker__inner">
				{marquee.items.map((item) => (
					<div class={itemClass}>
						<span class={tagClass}>[{item.tag}]</span>
						<span class={textClass}>{item.text}</span>
					</div>
				))}
			</div>
		</section>
	)
}

<style is:global>
	.home-ticker {
		position: relative;
		width: 100%;
		height: 2.75rem;
		overflow: hidden;
		margin-bottom: 1.5rem;
		padding: 0 0.5rem;
		/* 上下两条横线：跟随主题色相，比主题色加深 */
		border-top: 2px solid color-mix(in oklch, var(--primary) 55%, transparent);
		border-bottom: 2px solid color-mix(in oklch, var(--primary) 55%, transparent);
	}
	@media (min-width: 768px) {
		.home-ticker {
			padding: 0 1rem;
		}
	}
	.home-ticker__inner {
		position: relative;
		height: 100%;
	}
	.home-ticker__item {
		position: absolute;
		inset: 0;
		display: none;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		white-space: nowrap;
		font-size: 0.9rem;
		line-height: 1.5rem;
		color: var(--color-neutral-700);
	}
	:root.dark .home-ticker__item {
		color: var(--color-neutral-300);
	}
	.home-ticker__tag {
		font-weight: 600;
		color: var(--primary);
	}
	/* 当前显示的公告：滑入动画 */
	.home-ticker__item--active {
		display: flex;
		animation: home-ticker-in 0.5s ease;
	}
	@keyframes home-ticker-in {
		from {
			opacity: 0;
			transform: translateX(1.5rem);
		}
		to {
			opacity: 1;
			transform: translateX(0);
		}
	}
</style>

<script is:inline>
	(() => {
		const container = document.querySelector("#home-ticker");
		if (!container) return;
		const items = Array.from(container.querySelectorAll(".home-ticker__item"));
		if (items.length === 0) return;
		if (items.length === 1) {
			items[0].classList.add("home-ticker__item--active");
			return;
		}

		let current = 0;
		const INTERVAL = 4000; // 每条显示时长（毫秒）

		function show(index) {
			items.forEach((el, i) => {
				el.classList.toggle("home-ticker__item--active", i === index);
			});
		}

		show(0);
		setInterval(() => {
			current = (current + 1) % items.length;
			show(current);
		}, INTERVAL);
	})();
</script>
