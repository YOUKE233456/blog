---
// 首页公告跑马灯（fqzlr.com 同款结构：section.home-ticker > div.home-ticker__inner）
// 位于内容区最顶部（分类导航之前）
// 每条公告依次显示：滑入 → 停留 → 滑出 → 下一条（纯 CSS 轮换）
// 上下边框跟随主题色相
// 数据与开关见 src/config/homeWidgetsConfig.ts 的 marquee
import { homeWidgetsConfig } from "@/config/homeWidgetsConfig";

const { marquee } = homeWidgetsConfig;

const itemClass = "home-ticker__item";
const tagClass = "home-ticker__tag";
const textClass = "home-ticker__text";
---

{
	marquee.enable && marquee.items.length > 0 && (
		<section id="home-ticker" class="home-ticker" aria-label="公告跑马灯">
			<div class="home-ticker__inner">
				{marquee.items.map((item) => (
					<div class={itemClass}>
						<span class={tagClass}>[{item.tag}]</span>
						<span class={textClass}>{item.text}</span>
					</div>
				))}
			</div>
		</section>
	)
}

<style is:global>
	.home-ticker {
		position: relative;
		width: 100%;
		height: 2.75rem;
		overflow: hidden;
		margin-bottom: 1.5rem;
		padding: 0 0.5rem;
		/* 上下两条横线：跟随主题色相，比主题色加深 */
		border-top: 2px solid color-mix(in oklch, var(--primary) 55%, transparent);
		border-bottom: 2px solid color-mix(in oklch, var(--primary) 55%, transparent);
	}
	@media (min-width: 768px) {
		.home-ticker {
			padding: 0 1rem;
		}
	}
	.home-ticker__inner {
		position: relative;
		height: 100%;
	}
	.home-ticker__item {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		white-space: nowrap;
		font-size: 0.9rem;
		line-height: 1.5rem;
		color: var(--color-neutral-700);
		opacity: 0;
		animation: home-ticker-cycle 4s ease-in-out infinite;
	}
	:root.dark .home-ticker__item {
		color: var(--color-neutral-300);
	}
	.home-ticker__tag {
		font-weight: 600;
		color: var(--primary);
	}
	/* 每条公告错开显示（周期 = 条数 × 4s） */
	.home-ticker__item:nth-child(1) {
		animation-delay: 0s;
	}
	.home-ticker__item:nth-child(2) {
		animation-delay: 4s;
	}
	.home-ticker__item:nth-child(3) {
		animation-delay: 8s;
	}
	.home-ticker__item:nth-child(4) {
		animation-delay: 12s;
	}
	.home-ticker__item:nth-child(5) {
		animation-delay: 16s;
	}
	.home-ticker__item:nth-child(6) {
		animation-delay: 20s;
	}
	@keyframes home-ticker-cycle {
		0% {
			opacity: 0;
			transform: translateX(1.5rem);
		}
		5% {
			opacity: 1;
			transform: translateX(0);
		}
		85% {
			opacity: 1;
			transform: translateX(0);
		}
		95% {
			opacity: 0;
			transform: translateX(-1.5rem);
		}
		100% {
			opacity: 0;
			transform: translateX(-1.5rem);
		}
	}
	.home-ticker:hover .home-ticker__item {
		animation-play-state: paused;
	}
</style>
